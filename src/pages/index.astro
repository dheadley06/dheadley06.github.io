---
const pageTitle = "Home";

import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import Design from "../components/Design.astro";
import Hero from "../components/Hero.astro";
import Writing from "../components/Writing.astro";
---

<BaseLayout pageTitle = {pageTitle}>

    <section id="home" class="hero page__grid">
        <Hero />
    </section>

    <section id="about" class="about page__grid">
        <h1>01 • About</h1>
        <About />
    </section>

    <section id="writing" class="writing page__grid">
        <h1>02 • Writing</h1>
        <Writing />
    </section>

    <section id="design" class="design page__grid">
        <h1>03 • Design</h1>
        <Design />
    </section>

</BaseLayout>